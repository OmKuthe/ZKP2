# backend/.env.v2.example — Phase 0/1 dev environment for V2
# Copy to .env.v2 and adjust as needed.

DATABASE_URL=sqlite:///./v2.db

# V2 feature flags (default: write events on, challenges off)
V2_WRITE_EVENTS=true
V2_CHALLENGES_ENABLED=false
REVERIFY_TIMEOUT_MIN=5
V2_CHALLENGE_INTERVAL_MIN=20
V2_CHALLENGE_JITTER_MIN=5

# Timezone
DEFAULT_COMPANY_TZ=Asia/Kolkata

# Existing V1 config (keep as-is)
JWT_SECRET=dev-secret-change-me
QR_MASTER_SECRET=dev-qr-secret
DEBUG=True